#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/lru-fs PREFIX=/usr

# the test suite mounts FUSE filesystems, which build chroots can't do
override_dh_auto_test:

# mounting ~/scratch is each user's choice; don't enable the unit globally
override_dh_installsystemduser:
